# Local development defaults. For production, set the required values in your host's secret manager.
NODE_ENV=development
PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Exact origins only. In production set CORS_ORIGINS to comma-separated HTTPS origins.
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:5174
CORS_ORIGINS=https://tosif.site,https://tosif-portfolio-frontend.vercel.app

# In production this must be the absolute path of a persistent mounted volume.
UPLOAD_DIR=

# Optional integrations
GITHUB_USERNAME=
# Required for the live GitHub contribution calendar: create a classic token with read:user only.
# Keep this token server-side; do not add it to frontend environment variables.
GITHUB_TOKEN=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
