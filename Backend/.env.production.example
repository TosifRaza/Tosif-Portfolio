# Local development defaults. For production, set the required values in your host's secret manager.
NODE_ENV=development
PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Exact origins only. In production set CORS_ORIGINS to comma-separated HTTPS origins.
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:5174
CORS_ORIGINS=https://tosif.site,https://tosif-portfolio-frontend.vercel.app

# Required for resume files and legacy disk uploads. New portfolio images are stored in MongoDB.
# In production this must be the absolute path of a persistent mounted volume.
UPLOAD_DIR=

# Optional integrations
GITHUB_USERNAME=
# Optional: improves the contribution calendar's API access. If missing or invalid,
# the backend reads GitHub's public profile calendar instead. Keep tokens server-side.
GITHUB_TOKEN=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
