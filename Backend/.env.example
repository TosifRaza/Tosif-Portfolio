# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# MongoDB (leave empty to auto-start an in-memory MongoDB)
MONGO_URI=

# Auth
JWT_SECRET=founder_os_super_secret_change_me_in_production
JWT_EXPIRES_IN=7d

# Default admin (created on first boot if no users exist)
ADMIN_EMAIL=admin@founderos.dev
ADMIN_PASSWORD=admin123

# GitHub (optional - used by /github API)
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=
